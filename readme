<head>
<meta charset="UTF-8">
<title>나만의 독서 기록 사이트</title>

<style>
body {
    font-family: Arial, sans-serif;
    margin: 30px;
}

h1 {
    text-align: center;
}

input, select {
    padding: 8px;
    margin: 5px;
}

button {
    padding: 8px 15px;
}

.book {
    border: 1px solid black;
    padding: 10px;
    margin-top: 10px;
}
</style>

</head>
<body>

<h1>나만의 독서 기록 사이트</h1>

<input type="text" id="title" placeholder="책 제목">
<input type="text" id="author" placeholder="저자">
<input type="text" id="date" placeholder="읽은 날짜">

<select id="rating">
    <option value="1">1점</option>
    <option value="2">2점</option>
    <option value="3">3점</option>
    <option value="4">4점</option>
    <option value="5">5점</option>
</select>

<input type="text" id="review" placeholder="한줄평">

<button onclick="addBook()">등록</button>

<hr>

<div id="bookList"></div>

<script>
function addBook() {

    const title = document.getElementById("title").value;
    const author = document.getElementById("author").value;
    const date = document.getElementById("date").value;
    const rating = document.getElementById("rating").value;
    const review = document.getElementById("review").value;

    if(title === "" || author === "") {
        alert("책 제목과 저자를 입력하세요.");
        return;
    }

    const book = document.createElement("div");
    book.className = "book";

    book.innerHTML = `
        <h3>${title}</h3>
        <p>저자 : ${author}</p>
        <p>읽은 날짜 : ${date}</p>
        <p>별점 : ${rating}/5</p>
        <p>한줄평 : ${review}</p>
        <button onclick="this.parentElement.remove()">삭제</button>
    `;

    document.getElementById("bookList").appendChild(book);

    document.getElementById("title").value = "";
    document.getElementById("author").value = "";
    document.getElementById("date").value = "";
    document.getElementById("review").value = "";
}
</script>

</body>
</html>
